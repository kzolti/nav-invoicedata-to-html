{
  "name": "nav-invoicedata-to-html",
  "version": "2.0.2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/invoice-styles.css": "./dist/invoice-styles.css"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "tsc && cp src/i18n/*.json dist/i18n/ && node dist/test-full.js && cp src/styles/invoice-styles.css output/",
    "build": "tsc && cp src/i18n/*.json dist/i18n/ && cp src/styles/invoice-styles.css dist/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nav",
    "online-invoice",
    "nav-online-invoice",
    "hungary",
    "invoice",
    "xml-to-html",
    "osa"
  ],
  "author": {
    "name": "Zoltán István KADA",
    "company": "kAdatSoft",
    "email": "kada.zoli@gmail.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzolti/nav-invoicedata-to-html.git"
  },
  "description": "Hungarian NAV Online Invoice (OSA) XML data to HTML viewer and generator.",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.13",
    "nav-osa-types": "file:../nav-osa-types"
  }
}

{
  "name": "nav-invoicedata-to-html",
  "version": "2.0.4",
  "type": "module",
  "description": "Hungarian NAV Online Invoice (OSA) XML data to HTML viewer and generator.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/invoice-styles.css": "./dist/invoice-styles.css"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "tsc && cp src/i18n/*.json dist/i18n/ && node dist/test-full.js && cp src/styles/*.css output/",
    "test:compact": "IDTOHTML_CSS=compact npm run test",
    "build": "tsc && cp src/i18n/*.json dist/i18n/ && cp src/styles/*.css dist/ && rm -f dist/test-*.js dist/test-*.d.ts dist/test-*.d.ts.map",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nav",
    "online-invoice",
    "nav-online-invoice",
    "hungary",
    "invoice",
    "xml-to-html",
    "osa"
  ],
  "author": {
    "name": "Zoltán István KADA",
    "company": "kAdatSoft",
    "email": "kada.zoli@gmail.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzolti/nav-invoicedata-to-html.git"
  },
  "funding": [
    {
      "type": "Buy me a coffee (Revolut)",
      "url": "https://revolut.me/zoltnifdgo?note=nav-invoicedata-to-html"
    },
    {
      "type": "Buy me a coffee (GitHub)",
      "url": "https://github.com/sponsors/kzolti"
    }
  ],
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.13"
  },
"peerDependencies": {
     "nav-osa-core": "workspace:^",
     "nav-osa-types": "workspace:^"
   }
}

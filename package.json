{
  "name": "nav-invoicedata-to-html",
  "version": "2.0.4",
  "type": "module",
  "description": "Hungarian NAV Online Invoice (OSA) XML data to HTML viewer and generator.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser-entry.d.ts",
      "import": "./dist/browser-entry.js",
      "default": "./dist/browser-entry.js"
    },
    "./dist/invoice-styles.css": "./dist/invoice-styles.css"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "inline-assets": "node scripts/inline-assets.mjs",
    "build": "node scripts/inline-assets.mjs && tsc && cp src/styles/*.css dist/ && rm -f dist/test-*.js dist/test-*.d.ts dist/test-*.d.ts.map",
    "build:browser": "npm run build && node scripts/bundle-browser.mjs",
    "test": "node scripts/inline-assets.mjs && tsc && cp src/i18n/*.json dist/i18n/ && node dist/test-full.js && cp src/styles/*.css output/",
    "test:compact": "IDTOHTML_CSS=compact npm run test",
    "test:en": "IDTOHTML_LOCALE=en npm run test",
    "test:compact:en": "IDTOHTML_CSS=compact IDTOHTML_LOCALE=en npm run test",
    "test:langfree": "node scripts/inline-assets.mjs && tsc && node scripts/verify-langfree.mjs",
    "prepublishOnly": "npm run build:browser"
  },
  "keywords": [
    "nav",
    "online-invoice",
    "nav-online-invoice",
    "hungary",
    "invoice",
    "xml-to-html",
    "osa"
  ],
  "author": {
    "name": "Zoltán István KADA",
    "company": "kAdatSoft",
    "email": "kada.zoli@gmail.com"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzolti/nav-invoicedata-to-html.git"
  },
  "funding": [
    {
      "type": "Buy me a coffee (Revolut)",
      "url": "https://revolut.me/zoltnifdgo?note=nav-invoicedata-to-html"
    },
    {
      "type": "Buy me a coffee (GitHub)",
      "url": "https://github.com/sponsors/kzolti"
    }
  ],
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.13",
    "n2words-anycurrency": "^6.1.2"
  },
  "peerDependencies": {
    "nav-osa-core": "workspace:^",
    "nav-osa-types": "workspace:^"
  }
}
